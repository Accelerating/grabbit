# Copy to /etc/grabbit/grabbit.env on the server, then set ownership to
# root:grabbit and mode 0640.  Keep secrets (if added by the backend) here only;
# this file is an example and contains no credentials.

GRABBIT_PUBLIC_ORIGIN=https://grabbit.example.com
GRABBIT_SECURE_COOKIES=true

# Persistent application state.  The deployment layout is documented in
# deploy/README.md and in docs/implementation-plan.md.
GRABBIT_DATABASE_URL=sqlite+aiosqlite:////var/lib/grabbit/grabbit.db
GRABBIT_PRIVATE_ROOT=/var/lib/grabbit/private
GRABBIT_DOWNLOAD_ROOT=/srv/grabbit/downloads
